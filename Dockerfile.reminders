FROM python:3.13-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
# No web listener, migrations, bootstrap accounts, or document-storage access.
CMD ["sh", "-c", "python manage.py migrate --check && python manage.py process_notifications"]
