# Copy ONE group into the environment where the app will run.
# Do not use development credentials or the QuickBooks sandbox in production.

# =============================================================================
# GROUP 1 - DEVELOPMENT
# =============================================================================
DJANGO_SETTINGS_MODULE=config.settings.dev
APP_ENVIRONMENT=development
SECRET_KEY=django-insecure-development-only-change-me
TIME_ZONE=America/New_York
DJANGO_LOG_LEVEL=DEBUG
DJANGO_LOG_TO_FILE=true
DJANGO_LOG_DIRECTORY=logs

# Optional automatic superuser bootstrap for container startup
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=development-only-change-me
DJANGO_SUPERUSER_FIRST_NAME=Development
DJANGO_SUPERUSER_LAST_NAME=Administrator

# Local PostgreSQL (use DB_HOST=db when Django runs inside docker-compose)
DB_NAME=construction_manager_dev
DB_USER=construction_manager
DB_PASSWORD=development-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSL_REQUIRE=false

# Local cache and email capture
REDIS_URL=redis://127.0.0.1:6379/1
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Construction Manager <noreply@localhost>

# Public legal pages
LEGAL_BUSINESS_NAME=Construction Manager Development
LEGAL_CONTACT_EMAIL=support@example.com
LEGAL_BUSINESS_ADDRESS=123 Example Street, Example City, NY 10001
LEGAL_GOVERNING_LAW=State of New York, United States
LEGAL_EFFECTIVE_DATE=July 31, 2026

# Uploads
PRIVATE_MEDIA_ROOT=private_media
DOCUMENT_MAX_UPLOAD_SIZE_MB=25

# QuickBooks Online sandbox - development only
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_CLIENT_ID=replace-with-intuit-sandbox-client-id
QUICKBOOKS_CLIENT_SECRET=replace-with-intuit-sandbox-client-secret
QUICKBOOKS_REDIRECT_URI=http://localhost:8000/integrations/quickbooks/callback/
# Comma-separated Fernet keys; first key encrypts, remaining keys permit rotation.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
QUICKBOOKS_TOKEN_ENCRYPTION_KEYS=replace-with-generated-fernet-key
QUICKBOOKS_WEBHOOK_VERIFIER_TOKEN=replace-with-sandbox-webhook-token
QUICKBOOKS_HTTP_TIMEOUT_SECONDS=15
QUICKBOOKS_OAUTH_STATE_TTL_SECONDS=600

# =============================================================================
# GROUP 2 - PRODUCTION
# Copy this group into the production secret manager and remove leading "# ".
# Never commit real production values.
# =============================================================================
# DJANGO_SETTINGS_MODULE=config.settings.prod
# APP_ENVIRONMENT=production
# SECRET_KEY=replace-with-a-long-random-production-secret
# TIME_ZONE=America/New_York
